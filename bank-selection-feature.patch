diff --git a/database/migration_bank_selection.sql b/database/migration_bank_selection.sql
new file mode 100644
index 0000000..55d42a1
--- /dev/null
+++ b/database/migration_bank_selection.sql
@@ -0,0 +1,93 @@
+-- =====================================================================
+-- Migration: Bank selection on loans
+-- Run this once on your existing (Neon) database:
+--   psql "$DATABASE_URL" -f database/migration_bank_selection.sql
+-- (or paste into the Neon SQL Editor)
+--
+-- bank_id is left NULLABLE on purpose: your loans table already has
+-- live rows with no bank recorded, and there's no real bank value to
+-- backfill them with. New loans going forward are required to pick a
+-- bank at the application level (form validation), so bank_id will
+-- always be set for anything created from now on - existing loans will
+-- just show "Not specified" until edited.
+-- =====================================================================
+
+CREATE TABLE IF NOT EXISTS banks (
+    id            SERIAL PRIMARY KEY,
+    bank_name     VARCHAR(100) NOT NULL UNIQUE,
+    branch_code   VARCHAR(10)  NOT NULL
+);
+
+INSERT INTO banks (bank_name, branch_code) VALUES
+('Absa Bank', '632005'),
+('Access Bank South Africa', '410506'),
+('African Bank', '430000'),
+('Bank Zero', '888000'),
+('Bidvest Bank', '462005'),
+('Capitec Bank', '470010'),
+('Discovery Bank', '679000'),
+('First National Bank (FNB)', '250655'),
+('Grindrod Bank', '584000'),
+('Investec Bank', '580105'),
+('Mercantile Bank', '450905'),
+('Nedbank', '198765'),
+('Postbank (SAPO)', '460005'),
+('Sasfin Bank', '683000'),
+('Standard Bank', '051001'),
+('TymeBank', '678910'),
+('Ubank', '431010')
+ON CONFLICT (bank_name) DO NOTHING;
+
+ALTER TABLE loans ADD COLUMN IF NOT EXISTS bank_id INTEGER REFERENCES banks(id);
+CREATE INDEX IF NOT EXISTS idx_loans_bank ON loans(bank_id);
+
+-- Rebuild the register view to expose the bank name/code. New columns
+-- appended at the end - Postgres requires CREATE OR REPLACE VIEW to
+-- preserve the existing column order/positions. LEFT JOIN because
+-- bank_id can be NULL on existing loans.
+CREATE OR REPLACE VIEW loan_register_view AS
+SELECT
+    l.id,
+    l.reference_number,
+    c.id            AS client_id,
+    c.name,
+    c.surname,
+    c.id_number,
+    c.account_number,
+    c.phone,
+    l.amount,
+    b.id            AS branch_id,
+    b.branch_name,
+    lc.loan_count,
+    CASE
+        WHEN lc.loan_count BETWEEN 1 AND 3 THEN 'Group 1'
+        WHEN lc.loan_count BETWEEN 4 AND 8 THEN 'Group 2'
+        ELSE 'Group 3'
+    END AS loan_group,
+    l.loan_status_id,
+    ls.status_name  AS status,
+    l.repayment_status_id,
+    rs.status_name  AS repayment_status,
+    l.action_date,
+    l.created_at    AS date_loaded,
+    l.updated_at,
+    l.notes,
+    l.created_by,
+    l.workplace_name,
+    l.work_contact,
+    l.interest_amount,
+    l.amount_due,
+    l.bank_id,
+    bk.bank_name,
+    bk.branch_code  AS bank_branch_code
+FROM loans l
+JOIN clients c              ON c.id = l.client_id
+JOIN branches b              ON b.id = l.branch_id
+JOIN loan_statuses ls         ON ls.id = l.loan_status_id
+JOIN repayment_statuses rs    ON rs.id = l.repayment_status_id
+LEFT JOIN banks bk            ON bk.id = l.bank_id
+JOIN (
+    SELECT client_id, COUNT(*) AS loan_count
+    FROM loans
+    GROUP BY client_id
+) lc ON lc.client_id = l.client_id;
