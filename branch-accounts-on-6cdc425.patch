diff --git a/merged/database/migration_branch_accounts.sql b/merged/database/migration_branch_accounts.sql
new file mode 100644
index 0000000..90989f8
--- /dev/null
+++ b/merged/database/migration_branch_accounts.sql
@@ -0,0 +1,43 @@
+-- =====================================================================
+-- Migration: Branch-level accounts
+--
+-- Adds a third user role, 'Branch', for accounts tied to exactly one
+-- branch. A Branch account can capture and edit loans for its own
+-- branch only - it cannot change Loan Status / Repayment Status, run
+-- reports, manage other branches, manage users, or see other branches'
+-- data. Administrators and Operators are unaffected.
+--
+-- Run once on an existing database:
+--   psql -d loan_system -f database/migration_branch_accounts.sql
+-- (Also folded into database/schema.sql for brand-new installs.)
+-- Safe to re-run - every change is guarded.
+-- =====================================================================
+
+BEGIN;
+
+-- 1. Add branch_id to users (NULL for Administrator/Operator; required,
+--    enforced at the application layer, for role = 'Branch').
+ALTER TABLE users ADD COLUMN IF NOT EXISTS branch_id INTEGER REFERENCES branches(id);
+CREATE INDEX IF NOT EXISTS idx_users_branch ON users(branch_id);
+
+-- 2. Widen the role CHECK constraint to allow 'Branch'.
+--    (Constraint name follows Postgres's default naming; guarded so this
+--    is safe to re-run even if already applied.)
+DO $$
+BEGIN
+    IF EXISTS (
+        SELECT 1 FROM information_schema.table_constraints
+        WHERE table_name = 'users' AND constraint_name = 'users_role_check'
+    ) THEN
+        ALTER TABLE users DROP CONSTRAINT users_role_check;
+    END IF;
+    ALTER TABLE users ADD CONSTRAINT users_role_check
+        CHECK (role IN ('Administrator', 'Operator', 'Branch'));
+END $$;
+
+COMMIT;
+
+-- ---------------------------------------------------------------------
+-- Post-migration check (read-only, run manually):
+--   SELECT id, full_name, username, role, branch_id FROM users;
+-- ---------------------------------------------------------------------
